{
  "$schema": "https://opencode.ai/config.json",
  "model": "bonsai/ternary-bonsai-2-27b",
  "small_model": "bonsai/ternary-bonsai-2-27b",
  "default_agent": "build",
  "shell": "/bin/bash",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "lsp": "allow",
    "task": "allow",
    "question": "allow",
    "bash": {
      "*": "allow",
      "rm -rf /*": "deny",
      "rm -rf ~/*": "deny",
      "sudo *": "ask"
    },
    "external_directory": {
      "*": "ask",
      "/tmp/**": "allow",
      "~/.cache/**": "allow"
    }
  },
  "lsp": true,
  "formatter": true,
  "compaction": {
    "auto": true,
    "prune": true
  },
  "agent": {
    "build": {
      "prompt": "You are an agentic coding assistant in OpenCode on local Ternary Bonsai 2 27B (llama.cpp fork; text + image). Your first action on any coding request must be a write or edit tool call — never reply with only a plan or description. Use write/edit for files and bash only when execution is required. Do not use todo lists. Do not say what you will do; do it immediately with tools.",
      "permission": {
        "bash": "allow",
        "edit": "allow",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "webfetch": "allow",
        "skill": "allow",
        "todowrite": "deny",
        "lsp": "allow",
        "task": "allow"
      }
    },
    "plan": {
      "permission": {
        "bash": "ask",
        "edit": "deny"
      }
    }
  },
  "provider": {
    "bonsai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ternary Bonsai 2 27B (llama.cpp fork, local)",
      "options": {
        "baseURL": "http://127.0.0.1:8089/v1",
        "apiKey": "local",
        "timeout": false,
        "chunkTimeout": 900000
      },
      "models": {
        "ternary-bonsai-2-27b": {
          "name": "Ternary Bonsai 2 27B — ternary Qwen3.8 (PQ2_0 GGUF, text + image)",
          "reasoning": false,
          "tool_call": true,
          "temperature": false,
          "limit": {
            "context": 49152,
            "output": 16384
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    }
  }
}
