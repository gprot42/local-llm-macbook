{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "tensorfold-nemotron/nemotron-3.5-lightning-30b-tensorfold",
  "agent": {
    "build": {
      "temperature": 0.6,
      "top_p": 0.95,
      "top_k": 20
    },
    "plan": {
      "temperature": 0.6,
      "top_p": 0.95,
      "top_k": 20
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "pwd *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "less *": "allow",
      "tree *": "allow",
      "echo *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "type *": "allow",
      "file *": "allow",
      "diff *": "allow",
      "touch *": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "tsc *": "allow",
      "tsgo *": "allow",
      "tar *": "allow",
      "unzip *": "allow",
      "gzip *": "allow",
      "gunzip *": "allow",
      "adb *": "allow"
    }
  },
  "provider": {
    "tensorfold-nemotron": {
      "name": "TensorFold Nemotron 3.5 Lightning 30B-A3B (local)",
      "options": {
        "apiKey": "local",
        "baseURL": "http://127.0.0.1:8093/v1",
        "timeout": 900000,
        "headerTimeout": 180000,
        "chunkTimeout": 300000
      },
      "models": {
        "nemotron-3.5-lightning-30b-tensorfold": {
          "name": "Nemotron 3.5 Lightning 30B-A3B — TensorFold (MTP self-draft)",
          "tool_call": true,
          "limit": {
            "context": 49152,
            "output": 16384
          }
        }
      }
    }
  }
}
