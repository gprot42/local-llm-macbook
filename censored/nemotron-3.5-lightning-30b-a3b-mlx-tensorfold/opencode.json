{
  "$schema": "https://opencode.ai/config.json",
  "model": "nemotron-tensorfold/nemotron-3.5-lightning-30b-tensorfold",
  "small_model": "nemotron-tensorfold/nemotron-3.5-lightning-30b-tensorfold",
  "provider": {
    "nemotron-tensorfold": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TensorFold Nemotron 3.5 Lightning 30B-A3B (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8093/v1",
        "apiKey": "local",
        "timeout": false,
        "chunkTimeout": 900000
      },
      "models": {
        "nemotron-3.5-lightning-30b-tensorfold": {
          "name": "Nemotron 3.5 Lightning 30B-A3B — TensorFold (MTP self-draft, thinking off)",
          "reasoning": false,
          "tool_call": true,
          "temperature": false,
          "limit": {
            "context": 49152,
            "output": 16384
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  }
}
