{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "tensorfold-gemma4/gemma-4-26b-a4b-tensorfold",
  "agent": {
    "build": {
      "temperature": 0.35,
      "top_p": 0.9,
      "top_k": 40
    },
    "plan": {
      "temperature": 0.35,
      "top_p": 0.9,
      "top_k": 40
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "pwd *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "less *": "allow",
      "tree *": "allow",
      "echo *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "type *": "allow",
      "file *": "allow",
      "diff *": "allow",
      "touch *": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "tsc *": "allow",
      "tsgo *": "allow",
      "tar *": "allow",
      "unzip *": "allow",
      "gzip *": "allow",
      "gunzip *": "allow",
      "adb *": "allow"
    }
  },
  "provider": {
    "tensorfold-gemma4": {
      "name": "TensorFold Gemma 4 26B-A4B (base, local)",
      "options": {
        "apiKey": "local",
        "baseURL": "http://127.0.0.1:8092/v1",
        "timeout": 900000,
        "headerTimeout": 180000,
        "chunkTimeout": 300000
      },
      "models": {
        "gemma-4-26b-a4b-tensorfold": {
          "name": "Gemma 4 26B-A4B base — TensorFold (coding / agents)",
          "tool_call": true,
          "limit": {
            "context": 49152,
            "output": 16384
          }
        }
      }
    }
  }
}
